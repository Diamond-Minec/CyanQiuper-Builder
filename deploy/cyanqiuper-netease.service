[Unit]
Description=CyanQiuper NetEase import service
After=network.target cyanqiuper.service

[Service]
Type=simple
WorkingDirectory=/opt/cyanqiuper
EnvironmentFile=/opt/cyanqiuper/netease/netease.env
ExecStart=/usr/bin/env node node_modules/tsx/dist/cli.mjs netease-service.ts
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
